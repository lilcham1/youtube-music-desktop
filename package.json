{
  "name": "youtube-music-personal",
  "private": true,
  "version": "0.1.15",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "package:desktop": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.youtube.music.personal",
    "productName": "YouTube Music",
    "files": [
      "electron/**/*",
      "electron/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
